<plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-enforcer-plugin</artifactId>
    <version>3.7.0</version>
    <dependencies>
        <dependency>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>extra-enforcer-rules</artifactId>
            <version>1.12.1</version>
        </dependency>
    </dependencies>
    <executions>
        <execution>
            <id>enforce-rules</id>
            <goals>
                <goal>enforce</goal>
            </goals>
            <configuration>
                <rules>
                    <requireMavenVersion>
                        <version>3.9</version>
                    </requireMavenVersion>
                    <requireReleaseDeps>
                        <message>External SNAPSHOT dependencies are banned - a snapshot can change under you.</message>
                        <failWhenParentIsSnapshot>false</failWhenParentIsSnapshot>
                        <excludes>
                            <exclude>com.pavan.zenith:*</exclude>
                        </excludes>
                    </requireReleaseDeps>
                    <banDuplicateClasses/>
                </rules>
            </configuration>
        </execution>
    </executions>
</plugin>
